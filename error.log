def large_product(nums1, nums2, N):

    def top_k_largest_products(a, b, k):
        min_heap = []
        index2 = len(b) - 1
        for i in range(min(k, len(a))):
            for j in range(min(k, len(b))):
                if len(min_heap) < k:
                    heapq.heappush(min_heap, a[i] * b[j])
                else:
                    heapq.heappushpop(min_heap, a[i] * b[j])
                index2 -= 1
                if index2 < 0:
                    break
        (i, j) = (0, len(b) - 1)
        visited = set()
        while len(min_heap) < k and i < len(a) and (j >= 0):
            if (i, j) in visited:
                continue
            if a[i] * b[j] > min_heap[0]:
                heapq.heappop(min_heap)
                heapq.heappush(min_heap, a[i] * b[j])
            else:
                break
            if i + 1 < len(a):
                visited.add((i + 1, j))
            if j - 1 >= 0:
                visited.add((i, j - 1))
            i += 1
            j -= 1
        return sorted(min_heap, reverse=True)[:k]
    nums1.sort(reverse=True)
    nums2.sort(reverse=True)
