 Solution: def min_Swaps(str1, str2):
    if len(str1) != len(str2):
        return -1
    mismatch1 = 0
    mismatch0 = 0
    for a, b in zip(str1, str2):
        if a != b:
            if a == '1':
                mismatch1 += 1
            else:
                mismatch0 += 1
    if (mismatch1 + mismatch0) % 2 != 0:
