 Solution: import heapq
from itertools import islice
def large_product(nums1, nums2, N):

    def top_k_largest_products(nums1, nums2, k):
        min_heap = []
        i = 0
        j = len(nums2) - 1
        if not nums1 or not nums2 or k <= 0:
            return []
        initial_product = nums1[0] * nums2[j]
        heapq.heappush(min_heap, (initial_product, 0, j))
        result = []
        visited = set()
        visited.add((0, j))
        while min_heap and len(result) < k:
            (product, i1, i2) = heapq.heappop(min_heap)
            result.append(product)
            if (i1 + 1, i2) not in visited and i1 + 1 < len(nums1):
                heapq.heappush(min_heap, (nums1[i1 + 1] * nums2[i2], i1 + 1, i2))
                visited.add((i1 + 1, i2))
            if (i1, i2 - 1) not in visited and i2 - 1 >= 0:
                heapq.heappush(min_heap, (nums1[i1] * nums2[i2 - 1], i1, i2 - 1))
                visited.add((i1, i2 - 1))
        return result
    return top_k_largest_products(nums1, nums2, N).
 Test: def check():
