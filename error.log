 Solution: import heapq
from itertools import islice
def large_product(nums1, nums2, N):

    def top_k_largest_products(nums1, nums2, k):
        min_heap = []
        i = 0
        j = len(nums2) - 1
        initial_product = nums1[i] * nums2[j]
        heapq.heappush(min_heap, (initial_product, i, j))
        result = []
        visited = set((i, j))
        while min_heap and len(result) < k:
            (product, i_index, j_index) = heapq.heappop(min_heap)
            result.append(product)
            if (i_index + 1, j_index) not in visited:
                heapq.heappush(min_heap, (nums1[i_index + 1] * nums2[j_index], i_index + 1, j_index))
                visited.add((i_index + 1, j_index))
            if (i_index, j_index - 1) not in visited:
                heapq.heappush(min_heap, (nums1[i_index] * nums2[j_index - 1], i_index, j_index - 1))
                visited.add((i_index, j_index - 1))
        return result
    return top_k_largest_products(nums1, nums2, N).
