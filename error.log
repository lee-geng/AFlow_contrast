 Solution: def rgb_to_hsv(r, g, b):
    (r, g, b) = (r / 255.0, g / 255.0, b / 255.0)
    max_c = max(r, g, b)
    min_c = min(r, g, b)
    delta = max_c - min_c
    if delta == 0:
        h = 0
    elif max_c == r:
        h = (g - b) / delta % 6
    elif max_c == g:
        h = (b - r) / delta + 2
    else:
        h = (r - g) / delta + 4
    h = int(h * 60)
    if h < 0:
        h += 360
    if max_c == 0:
        s = 0
    else:
        s = delta / max_c
    v = max_c * 100
    return (h, s, v).
