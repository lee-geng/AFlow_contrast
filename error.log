from itertools import islice
def large_product(nums1, nums2, N):

    def get_top_k_products(nums1, nums2, k):
        if not nums1 or not nums2:
            return []
        max_heap = []
        visited = set()
        (i1, i2) = (0, 0)
        heapq.heappush(max_heap, (-nums1[i1] * nums2[i2], i1, i2))
        visited.add((i1, i2))
        result = []
        while len(result) < k and max_heap:
            (product, i1, i2) = heapq.heappop(max_heap)
            result.append(-product)
            if i1 + 1 < len(nums1) and (i1 + 1, i2) not in visited:
                heapq.heappush(max_heap, (-nums1[i1 + 1] * nums2[i2], i1 + 1, i2))
                visited.add((i1 + 1, i2))
            if i2 + 1 < len(nums2) and (i1, i2 + 1) not in visited:
                heapq.heappush(max_heap, (-nums1[i1] * nums2[i2 + 1], i1, i2 + 1))
                visited.add((i1, i2 + 1))
        return result
    return get_top_k_products(nums1, nums2, N).
