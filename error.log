 Solution: from collections import defaultdict
def count_Substrings(s):
    count = 0
    prefix_sum = 0
    prefix_counts = defaultdict(int)
    prefix_counts[0] = 1
    for i in range(len(s)):
        prefix_sum += int(s[i])
        target = prefix_sum - (i + 1)
        count += prefix_counts[target]
        prefix_counts[prefix_sum] += 1
    return count.
