 Solution: def eulerian_num(n, m):

    def factorial(x):
        if x == 0:
            return 1
        res = 1
        for i in range(2, x + 1):
            res *= i
        return res
    result = 0
    for k in range(m + 1):
        sign = (-1) ** k
        numerator = factorial(n + 1)
        denominator = factorial(k) * factorial(m - k) * factorial(n - m + k)
        result += sign * numerator // denominator
    return result.
