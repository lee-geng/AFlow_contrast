 Solution: def eulerian_num(n, m):

    def factorial(x):
        if x == 0:
            return 1
        res = 1
        for i in range(2, x + 1):
            res *= i
        return res
    total = 0
    for k in range(m + 1):
        total += (-1) ** k * factorial(n + 1) / (factorial(k) * factorial(n - m - k) * factorial(m - k + 1))
    return int(total).
 Test: def check():
