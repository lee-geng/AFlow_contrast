 Solution: import heapq
def k_smallest_pairs(nums1, nums2, k):
    if not nums1 or not nums2:
        return []
    min_heap = []
    result = []
    for i in range(len(nums1)):
        heapq.heappush(min_heap, (nums1[i] + nums2[0], 0, i))
    while min_heap and len(result) < k:
        (current_sum, j, i) = heapq.heappop(min_heap)
        result.append([nums1[i], nums2[j]])
        if j + 1 < len(nums2):
            heapq.heappush(min_heap, (nums1[i] + nums2[j + 1], j + 1, i))
    return result.
