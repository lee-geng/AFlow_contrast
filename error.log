def find_adverbs(text):
    pattern = '\\b\\w+ly\\b'
    matches = re.finditer(pattern, text)
    for match in matches:
        word = match.group()
        start = match.start()
        end = match.end()
        return f'{start}-{end - 1}: {word}'
    return None.
