    for i in range(rotations):
        left = ranges[i][0]
        right = ranges[i][1]
        length = right - left + 1
        shift = length - (right - left + 1)
        if shift < 0:
            shift += length
        for j in range(abs(shift)):
            if shift > 0:
                temp = arr[right]
                for k in range(right, left, -1):
