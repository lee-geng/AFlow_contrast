 Solution: def extract_even(test_tuple):

    def helper(element):
        if isinstance(element, int):
            return element % 2 == 0
        elif isinstance(element, tuple):
            cleaned = tuple((helper(e) for e in element))
            return tuple((e for e in cleaned if e is not None or isinstance(e, tuple)))
        return None
    result = tuple((helper(e) for e in test_tuple))
    return tuple((e for e in result if e is not None or isinstance(e, tuple))).
