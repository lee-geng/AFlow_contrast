        if nums1 and nums2:
            heapq.heappush(max_heap, (-nums1[i] * nums2[j], i, j))
        visited = set()
        visited.add((i, j))
        results = []
        while k > 0 and max_heap:
            (product, i, j) = heapq.heappop(max_heap)
            results.append(-product)
            k -= 1
            if i + 1 < len(nums1) and (i + 1, j) not in visited:
