def large_product(nums1, nums2, N):

    def top_k_product(k):
        i = len(nums1) - 1
        j = 0
        heap = []
        seen = set()
        heapq.heappush(heap, (-nums1[i] * nums2[j], i, j))
        seen.add((i, j))
        result = []
        while len(result) < k and heap:
            (prod, i_heap, j_heap) = heapq.heappop(heap)
            result.append(-prod)
            if (i_heap - 1, j_heap) not in seen and i_heap > 0:
                heapq.heappush(heap, (-nums1[i_heap - 1] * nums2[j_heap], i_heap - 1, j_heap))
                seen.add((i_heap - 1, j_heap))
            if (i_heap, j_heap + 1) not in seen and j_heap < len(nums2) - 1:
                heapq.heappush(heap, (-nums1[i_heap] * nums2[j_heap + 1], i_heap, j_heap + 1))
                seen.add((i_heap, j_heap + 1))
        return result
    return top_k_product(N).
