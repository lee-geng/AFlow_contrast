 Solution: def get_ludic(n):
    if n < 1:
        return []
    ludic = list(range(1, n + 1))
    i = 1
    while i < len(ludic):
        remove_index = ludic[i]
        ludic = [num for idx, num in enumerate(ludic) if idx % remove_index != 0 or idx == 0]
