 Solution: def cal_sum(n):
    if n < 0:
        return 0
    if n == 0:
        return 3
    if n == 1:
        return 3
    if n == 2:
        return 5
    a, b, c = (3, 0, 2)
    total = a + b + c
    for _ in range(3, n + 1):
        next_val = b + c
        total += next_val
        a, b, c = (b, c, next_val)
    return total.
 Test: def check():
    assert cal_sum(9) == 49
    assert cal_sum(10) == 66
    assert cal_sum(11) == 88

