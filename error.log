from itertools import islice
def large_product(nums1, nums2, N):

    def top_k_product(k):
        nums1_sorted = sorted(nums1)
        nums2_sorted = sorted(nums2)
        heap = []
        visited = set()
        i = 0
        j = len(nums2_sorted) - 1
        max_heap_size = k

        def push(i, j):
            if (i, j) not in visited:
                visited.add((i, j))
                product = nums1_sorted[i] * nums2_sorted[j]
                if len(heap) < max_heap_size:
                    heapq.heappush(heap, (product, i, j))
                else:
                    heapq.heappushpop(heap, (product, i, j))
        push(i, j)
        result = []
        while heap and len(result) < k:
            (product, i, j) = heapq.heappop(heap)
            result.append(product)
            if i + 1 < len(nums1_sorted):
                push(i + 1, j)
            if j - 1 >= 0:
                push(i, j - 1)
        return result[::-1]
    return top_k_product(N).
