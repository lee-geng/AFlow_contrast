 Solution: def eulerian_num(n, m):
    from math import comb
    result = 0
    for k in range(m + 1):
        sign = (-1) ** k
        binom = comb(m + 1, k)
        power = (m + 1 - k) ** n
        result += sign * binom * power
    return result // 2 ** (m == 0).
