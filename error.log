def count_Substrings(s):
    from itertools import accumulate
    n = len(s)
    prefix_sum = [0] * (n + 1)
    for i in range(n):
        prefix_sum[i + 1] = prefix_sum[i] + int(s[i])
    count = 0
    pos = defaultdict(list)
    pos[0].append(0)
    for i in range(1, n + 1):
        for j in pos[prefix_sum[i]]:
            if i - j == prefix_sum[i] - prefix_sum[j]:
                count += 1
        pos[prefix_sum[i]].append(i)
    return count.
