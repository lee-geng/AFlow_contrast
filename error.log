 Solution: def pancake_sort(nums):

    def flip(sublist, k):
        i = 0
        while i < k:
            sublist[i], sublist[k] = (sublist[k], sublist[i])
            i += 1
            k -= 1
    n = len(nums)
    result = []
    for size in range(n, 0, -1):
        max_index = 0
        for i in range(size):
            if nums[i] > nums[max_index]:
                max_index = i
        if max_index != 0:
            flip(nums, max_index)
            result.append(max_index + 1)
        flip(nums, size - 1)
        result.append(size)
    return result.
 Test: def check():
    assert pancake_sort([15, 79, 25, 38, 69]) == [15, 25, 38, 69, 79]
    assert pancake_sort([98, 12, 54, 36, 85]) == [12, 36, 54, 85, 98]
    assert pancake_sort([41, 42, 32, 12, 23]) == [12, 23, 32, 41, 42]

