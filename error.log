 Solution: import math
def rgb_to_hsv(r, g, b):
    (r, g, b) = (r / 255.0, g / 255.0, b / 255.0)
    max_val = max(r, g, b)
    min_val = min(r, g, b)
    delta = max_val - min_val
    h = 0.0
    if delta != 0:
        if max_val == r:
            h = (g - b) / delta % 6
        elif max_val == g:
            h = (b - r) / delta + 2
        else:
            h = (r - g) / delta + 4
    h = h * 60
    if h < 0:
        h += 360
    s = 0.0 if max_val == 0 else delta / max_val * 100
    v = max_val * 100
    return (round(h, 4), round(s, 4), round(v, 4)).
 Test: def check():
