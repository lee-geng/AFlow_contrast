 Solution: def max_sum_increasing_subseq(a, n, index, k):
    if index < 0 or k <= index or k >= n:
        return -1
    if a[k] <= a[index]:
        return -1
    dp = [0] * n
    dp[0] = a[0]
    for i in range(1, n):
        dp[i] = a[i]
        for j in range(i):
            if a[i] > a[j]:
                dp[i] = max(dp[i], dp[j] + a[i])
    max_sum = a[k]
    for i in range(index + 1, k):
        if a[i] < a[k]:
            max_sum = max(max_sum, dp[i] + a[k])
    return max_sum.
