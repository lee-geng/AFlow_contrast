        j = len(nums2) - 1
        if nums1 and nums2:
            heapq.heappush(min_heap, (-nums1[i] * nums2[j], i, j))
        seen = set()
        results = []
        while k > 0 and min_heap:
            (product, i_index, j_index) = heapq.heappop(min_heap)
            results.append(-product)
            k -= 1
            if (i_index + 1, j_index) not in seen and i_index + 1 < len(nums1):
                seen.add((i_index + 1, j_index))
                heapq.heappush(min_heap, (-nums1[i_index + 1] * nums2[j_index], i_index + 1, j_index))
            if (i_index, j_index - 1) not in seen and j_index - 1 >= 0:
                seen.add((i_index, j_index - 1))
                heapq.heappush(min_heap, (-nums1[i_index] * nums2[j_index - 1], i_index, j_index - 1))
        return results
    return top_k_product(N, nums1, nums2).
