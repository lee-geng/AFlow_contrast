 Solution: def find_length(string):
    max_len = 0
    current_diff = 0
    prefix_sums = {0: -1}
    for (i, ch) in enumerate(string):
        if ch == '0':
            current_diff += 1
        else:
            current_diff -= 1
        if current_diff in prefix_sums:
            max_len = max(max_len, i - prefix_sums[current_diff])
        else:
            prefix_sums[current_diff] = i
    return max_len.
