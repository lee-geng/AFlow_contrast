 Solution: import math
def sum_of_divisors(n):
    if n == 0:
        return 0
    total = 1
    sqrt_n = int(math.sqrt(n))
    for i in range(2, sqrt_n + 1):
        if n % i == 0:
            total += i
            if i != n // i:
                total += n // i
    if n > 1:
        total += n
    return total
def are_equivalent(num1, num2):
    return sum_of_divisors(num1) == sum_of_divisors(num2).
 Test: def check():
