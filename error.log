 Solution: from collections import defaultdict
from typing import Any, List, Tuple
def max_occurrences(nums: List[Any]) -> Tuple[Any, int]:
    freq = defaultdict(int)
    for num in nums:
        freq[num] += 1
    max_item = None
    max_count = 0
    for (item, count) in freq.items():
        if count > max_count:
            max_count = count
            max_item = item
    return (max_item, max_count).
