 Solution: def eulerian_num(n, m):

    def combination(n, k):
        if k < 0 or k > n:
            return 0
        if k == 0 or k == n:
            return 1
        k = min(k, n - k)
        result = 1
        for i in range(k):
            result = result * (n - i) // (i + 1)
        return result
    result = 0
    for k in range(m + 1):
        result += (-1) ** k * combination(n + 1, k) * (n - k) ** n
    return result // 2 ** n.
