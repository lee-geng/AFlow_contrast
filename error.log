 Solution: from collections import deque
def min_Jumps(steps, d):
    steps = [float(s) for s in steps]
    visited = set()
    queue = deque()
    queue.append((0.0, 0.0, 0.0))
    visited.add((0.0, 0.0))
    while queue:
        x, y, jumps = queue.popleft()
        if abs(x - d) < 1e-09 and abs(y) < 1e-09:
            return jumps
        for step in steps:
            for dx, dy in [(step, 0), (0, step), (-step, 0), (0, -step)]:
                nx, ny = (x + dx, y + dy)
                if (abs(nx), abs(ny)) not in visited:
                    visited.add((abs(nx), abs(ny)))
                    queue.append((nx, ny, jumps + 1.0))
    return -1.
