 Solution: def bell_number(n):
    if n < 0:
        return 0
    bell = [[0] * n for _ in range(n)]
    bell[0][0] = 1
    for i in range(1, n):
        bell[i][0] = bell[i - 1][i - 1]
        for j in range(1, i + 1):
            bell[i][j] = bell[i - 1][j - 1] + bell[i][j - 1]
    return bell[n - 1][0].
 Test: def check():
