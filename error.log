 Solution: def max_sum_increasing_subseq(a, n, index, k):
    if index < 0 or k <= index or k >= n:
        return -1
    dp = [0] * n
    dp[index] = a[index]
    for i in range(index + 1, k):
        dp[i] = a[i]
        for j in range(index, i):
            if a[i] > a[j]:
                dp[i] = max(dp[i], dp[j] + a[i])
    result = a[k]
