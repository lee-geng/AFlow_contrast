 Solution: def find_First_Missing(array, start=0, end=None):
    if not array:
        return start
    if end is None:
        end = len(array) - 1
    if array[end] == end + start:
        return end + start + 1
    while start <= end:
        mid = (start + end) // 2
        if array[mid] == mid + start:
            start = mid + 1
        else:
            end = mid - 1
    return start.
