 Solution: def sum_div(number):
    """
    Calculate the sum of all divisors of a given number, including the number itself.
    
    Parameters:
        number (int): A positive integer
    
    Returns:
        int: Sum of all divisors of the number
    """
    if number <= 0:
        return 0
    total = 0
    i = 1
    while i * i <= number:
        if number % i == 0:
            total += i
            if i != number // i:
                total += number // i
        i += 1
    return total.
 Test: def check():
    assert sum_div(8)==7
    assert sum_div(12)==16
    assert sum_div(7)==1

