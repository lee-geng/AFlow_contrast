    vowels = set('aeiouAEIOU')
    count = 0
    for i in range(len(test_str)):
        if i > 0 and i < len(test_str) - 1:
            if test_str[i - 1] in vowels or test_str[i + 1] in vowels:
                count += 1
        elif i == 0:
            if test_str[i + 1] in vowels:
                count += 1
        elif i == len(test_str) - 1:
            if test_str[i - 1] in vowels:
                count += 1
    return count.
