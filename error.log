 Solution: def eulerian_num(n, m):
    if n < 0 or m < 0 or m >= n:
        return 0

    def A(n, m):
        total = 0
        for k in range(m + 1):
            total += (-1) ** k * (1 - 2 ** k) * 2 ** (n - k) * (k + 1) ** n
        return total // 2 ** n
    return A(n, m).
