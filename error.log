 Solution: def eulerian_num(n, m):
    from math import comb

    def factorial(x):
        if x == 0:
            return 1
        res = 1
        for i in range(1, x + 1):
            res *= i
        return res
    result = 0
    for k in range(m + 1):
        result += (-1) ** k * comb(n + 1, k) * (n - k) ** n
    return result // factorial(n + 1).
