    count = 0
    prefix_sum = 0
    sum_count = defaultdict(int)
    sum_count[0] = 1
    for i in range(len(s)):
        prefix_sum += int(s[i])
        count += sum_count[prefix_sum - (i + 1)]
        sum_count[prefix_sum] += 1
    return count.
